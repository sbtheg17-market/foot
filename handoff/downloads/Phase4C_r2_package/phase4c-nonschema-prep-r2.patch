+# Phase 4C — Consent-First Client Comfort Profile — OpenAPI DRAFT
+#
+# STATUS: DRAFT (x-status: draft). Non-schema preparation artifact only.
+# Derived from docs/comfort-profile/PHASE_4C_COMFORT_PROFILE_CONTRACT_V3.md
+# (SHA-256 339a03e6bb2c7aab6cee7306bb1daff43003a46c6edbbf16f2ed77c2d5fe4a4f).
+#
+# This file is intentionally kept OUTSIDE lib/api-spec/openapi.yaml.
+# Merging into the canonical spec and running orval codegen is step C-1 of the
+# contract's implementation sequencing and requires implementation review
+# approval. No codegen has been run against this draft.
+#
+# Binding rules encoded here (contract §2):
+#   - consent-first: PUT profile is rejected without active consent (409)
+#   - optional-everything: every field is optional; "unspecified" defaults
+#   - owner-scoped: /clients/me/* routes are self-only
+#   - provider projection: booking-scoped, active statuses only, visible
+#     categories only, 404 (never 403) on any denial
+#   - language rule: descriptions say "matches your preferences" only
+
+openapi: 3.1.0
+info:
+  title: Api
+  version: 0.3.0-comfort-draft
+  description: >-
+    OnCall Foot API — Phase 4C comfort profile DRAFT slice. Comfort preferences
+    describe what matches a client's preferences. They are never medical
+    guidance and never affect discovery or ranking.
+x-status: draft
+x-contract-checksum: 339a03e6bb2c7aab6cee7306bb1daff43003a46c6edbbf16f2ed77c2d5fe4a4f
+servers:
+  - url: /api
+    description: Base API path
+tags:
+  - name: comfort-profile
+    description: Consent-first client comfort preferences (owner-scoped)
+  - name: comfort-projection
+    description: Booking-scoped provider projection of client-visible categories
+
+paths:
+  /clients/me/comfort-profile:
+    get:
+      operationId: getMyComfortProfile
+      tags: [comfort-profile]
+      summary: Get my comfort profile
+      description: >-
+        Returns the authenticated client's comfort profile, per-category
+        visibility flags, and current consent state. Owner-scoped.
+      security:
+        - bearerAuth: []
+      responses:
+        "200":
+          description: Profile with visibility flags and consent state
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ComfortProfileResponse"
+        "204":
+          description: No profile exists yet (empty state)
+        "401":
+          $ref: "#/components/responses/Unauthorized"
+    put:
+      operationId: putMyComfortProfile
+      tags: [comfort-profile]
+      summary: Create or update my comfort profile
+      description: >-
+        Upserts structured preference fields and per-category visibility flags.
+        Rejected when the client has no active consent. All enums are closed
+        sets; unknown keys are rejected.
+      security:
+        - bearerAuth: []
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ComfortProfileUpsertRequest"
+      responses:
+        "200":
+          description: Profile saved
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ComfortProfileResponse"
+        "400":
+          $ref: "#/components/responses/BadRequest"
+        "401":
+          $ref: "#/components/responses/Unauthorized"
+        "409":
+          description: No active consent — grant consent before saving
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ErrorResponse"
+    delete:
+      operationId: deleteMyComfortProfile
+      tags: [comfort-profile]
+      summary: Delete my comfort profile
+      description: >-
+        Hard-deletes the profile row. Consent history is retained as an audit
+        record.
+      security:
+        - bearerAuth: []
+      responses:
+        "204":
+          description: Profile deleted
+        "401":
+          $ref: "#/components/responses/Unauthorized"
+        "404":
+          description: No profile exists
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ErrorResponse"
+
+  /clients/me/comfort-consent:
+    post:
+      operationId: grantComfortConsent
+      tags: [comfort-profile]
+      summary: Grant comfort-profile consent
+      description: >-
+        Records versioned consent. The server stores the SHA-256 hash of the
+        exact consent text it served for the requested version.
+      security:
+        - bearerAuth: []
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ComfortConsentGrantRequest"
+      responses:
+        "201":
+          description: Consent granted
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ComfortConsentState"
+        "400":
+          $ref: "#/components/responses/BadRequest"
+        "401":
+          $ref: "#/components/responses/Unauthorized"
+    delete:
+      operationId: withdrawComfortConsent
+      tags: [comfort-profile]
+      summary: Withdraw comfort-profile consent
+      description: >-
+        Withdraws consent immediately. The provider projection goes dark on the
+        next request. Withdrawal is reversible by granting consent again.
+      security:
+        - bearerAuth: []
+      responses:
+        "200":
+          description: Consent withdrawn
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ComfortConsentState"
+        "401":
+          $ref: "#/components/responses/Unauthorized"
+        "404":
+          description: No active consent to withdraw
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ErrorResponse"
+
+  /bookings/{bookingId}/client-comfort:
+    get:
+      operationId: getBookingClientComfort
+      tags: [comfort-projection]
+      summary: Booking-scoped client comfort projection
+      description: >-
+        Returns the filtered projection of the client's comfort preferences for
+        this booking. Only the provider who owns the booking may call this, only
+        while the booking status is in the active set (confirmed, en_route,
+        in_progress), only while the client's consent is active, and only for
+        the categories the client has made visible. Every denial returns 404 —
+        never 403 — so the existence of a profile is not confirmed.
+      security:
+        - bearerAuth: []
+      parameters:
+        - name: bookingId
+          in: path
+          required: true
+          schema:
+            type: integer
+      responses:
+        "200":
+          description: Client-visible categories only
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ComfortProjectionResponse"
+        "401":
+          $ref: "#/components/responses/Unauthorized"
+        "404":
+          description: >-
+            Not available (booking not owned, booking not active, consent
+            inactive, no profile, or nothing visible). Never 403.
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ErrorResponse"
+
+components:
+  securitySchemes:
+    bearerAuth:
+      type: http
+      scheme: bearer
+      bearerFormat: JWT
+  responses:
+    BadRequest:
+      description: Validation error
+      content:
+        application/json:
+          schema:
+            $ref: "#/components/schemas/ErrorResponse"
+    Unauthorized:
+      description: Missing or invalid authentication
+      content:
+        application/json:
+          schema:
+            $ref: "#/components/schemas/ErrorResponse"
+  schemas:
+    ErrorResponse:
+      type: object
+      required: [error]
+      properties:
+        error:
+          type: string
+
+    BookingReason:
+      type: string
+      enum: [unspecified, comfort, relaxation, appearance, recurring_care, mobility_support, other_personal_goal]
+      default: unspecified
+    PressurePreference:
+      type: string
+      enum: [unspecified, very_light, light, moderate, firm]
+      default: unspecified
+    TouchSensitivity:
+      type: string
+      enum: [unspecified, low, medium, high]
+      default: unspecified
+    TemperaturePreference:
+      type: string
+      enum: [unspecified, cooler, neutral, warmer]
+      default: unspecified
+    FragrancePreference:
+      type: string
+      enum: [unspecified, fragrance_free_required, light_fragrance_ok, no_preference]
+      default: unspecified
+    SensitivityFlag:
+      type: string
+      enum: [sensitive_skin, allergy_common_lotions, allergy_latex, neuropathy_care_attention, bruises_easily]
+    AccessibilityNeed:
+      type: string
+      enum: [limited_mobility, uses_wheelchair, needs_seated_service, service_animal_present, stairs_at_entrance]
+    SettingPreference:
+      type: string
+      enum: [unspecified, at_home_only, studio_ok, either]
+      default: unspecified
+    PreferredDurationBucket:
+      type: string
+      enum: [unspecified, short_30_45, standard_60, extended_75_plus]
+      default: unspecified
+    PreferredTimeWindow:
+      type: string
+      enum: [weekday_morning, weekday_afternoon, weekday_evening, weekend_morning, weekend_afternoon, weekend_evening]
+    CommunicationPreference:
+      type: string
+      enum: [unspecified, chatty, quiet_visit, no_preference]
+      default: unspecified
+
+    ComfortVisibilityFlags:
+      type: object
+      description: >-
+        Per-category visibility toggles. Every category defaults to hidden
+        (false) until the client turns it on — privacy by default.
+      properties:
+        bookingReason: { type: boolean, default: false }
+        comfort: { type: boolean, default: false }
+        sensitivities: { type: boolean, default: false }
+        accessibility: { type: boolean, default: false }
+        setting: { type: boolean, default: false }
+        appointmentShape: { type: boolean, default: false }
+        communication: { type: boolean, default: false }
+        visitNote: { type: boolean, default: false }
+      additionalProperties: false
+
+    ComfortPreferences:
+      type: object
+      description: All fields optional — the profile never blocks booking.
+      properties:
+        bookingReason: { $ref: "#/components/schemas/BookingReason" }
+        pressurePreference: { $ref: "#/components/schemas/PressurePreference" }
+        touchSensitivity: { $ref: "#/components/schemas/TouchSensitivity" }
+        temperaturePreference: { $ref: "#/components/schemas/TemperaturePreference" }
+        fragrancePreference: { $ref: "#/components/schemas/FragrancePreference" }
+        sensitivityFlags:
+          type: array
+          items: { $ref: "#/components/schemas/SensitivityFlag" }
+          uniqueItems: true
+        accessibilityNeeds:
+          type: array
+          items: { $ref: "#/components/schemas/AccessibilityNeed" }
+          uniqueItems: true
+        settingPreference: { $ref: "#/components/schemas/SettingPreference" }
+        preferredDurationBucket: { $ref: "#/components/schemas/PreferredDurationBucket" }
+        preferredTimeWindows:
+          type: array
+          items: { $ref: "#/components/schemas/PreferredTimeWindow" }
+          uniqueItems: true
+        communicationPreference: { $ref: "#/components/schemas/CommunicationPreference" }
+        languagePreference:
+          type: string
+          description: BCP-47 language tag from the curated list (see contract §4).
+          maxLength: 35
+        visitNote:
+          type: string
+          maxLength: 280
+          description: >-
+            Optional, explicitly non-sensitive note about the visit. Hidden from
+            providers unless the visit_note category is toggled visible.
+      additionalProperties: false
+
+    ComfortProfileUpsertRequest:
+      type: object
+      required: [preferences, visibility]
+      properties:
+        preferences: { $ref: "#/components/schemas/ComfortPreferences" }
+        visibility: { $ref: "#/components/schemas/ComfortVisibilityFlags" }
+      additionalProperties: false
+
+    ComfortConsentGrantRequest:
+      type: object
+      required: [version]
+      properties:
+        version:
+          type: integer
+          minimum: 1
+      additionalProperties: false
+
+    ComfortConsentState:
+      type: object
+      required: [status]
+      properties:
+        status:
+          type: string
+          enum: [none, active, withdrawn]
+        version: { type: integer }
+        consentTextHash:
+          type: string
+          description: SHA-256 of the exact consent copy shown to the client.
+        grantedAt: { type: string, format: date-time }
+        withdrawnAt: { type: string, format: date-time }
+      additionalProperties: false
+
+    ComfortProfileResponse:
+      type: object
+      required: [preferences, visibility, consent]
+      properties:
+        preferences: { $ref: "#/components/schemas/ComfortPreferences" }
+        visibility: { $ref: "#/components/schemas/ComfortVisibilityFlags" }
+        consent: { $ref: "#/components/schemas/ComfortConsentState" }
+        updatedAt: { type: string, format: date-time }
+      additionalProperties: false
+
+    ComfortProjectionResponse:
+      type: object
+      description: >-
+        Booking-scoped, consent-gated, client-visible categories only. Wording
+        for providers is always "matches your preferences" — never medical
+        phrasing. Categories the client kept hidden are entirely absent.
+      properties:
+        bookingReason: { $ref: "#/components/schemas/BookingReason" }
+        comfort:
+          type: object
+          properties:
+            pressurePreference: { $ref: "#/components/schemas/PressurePreference" }
+            touchSensitivity: { $ref: "#/components/schemas/TouchSensitivity" }
+            temperaturePreference: { $ref: "#/components/schemas/TemperaturePreference" }
+            fragrancePreference: { $ref: "#/components/schemas/FragrancePreference" }
+          additionalProperties: false
+        sensitivities:
+          type: array
+          items: { $ref: "#/components/schemas/SensitivityFlag" }
+        accessibility:
+          type: array
+          items: { $ref: "#/components/schemas/AccessibilityNeed" }
+        setting: { $ref: "#/components/schemas/SettingPreference" }
+        appointmentShape:
+          type: object
+          properties:
+            preferredDurationBucket: { $ref: "#/components/schemas/PreferredDurationBucket" }
+            preferredTimeWindows:
+              type: array
+              items: { $ref: "#/components/schemas/PreferredTimeWindow" }
+          additionalProperties: false
+        communication:
+          type: object
+          properties:
+            communicationPreference: { $ref: "#/components/schemas/CommunicationPreference" }
+            languagePreference: { type: string }
+          additionalProperties: false
+        visitNote:
+          type: string
+          maxLength: 280
+      additionalProperties: false
