+/**
+ * Phase 4C — Consent-First Client Comfort Profile — CONTRACT MODULE (draft)
+ *
+ * Non-schema preparation artifact. Encodes the closed vocabularies, visibility
+ * semantics, consent semantics, and the provider-projection filtering rules
+ * from docs/comfort-profile/PHASE_4C_COMFORT_PROFILE_CONTRACT_V3.md
+ * (SHA-256 339a03e6bb2c7aab6cee7306bb1daff43003a46c6edbbf16f2ed77c2d5fe4a4f).
+ *
+ * Intentionally dependency-free (no zod, no drizzle, no storage imports):
+ * the canonical Zod schemas will be generated from the OpenAPI spec at
+ * implementation step C-1. Nothing in this module touches the database,
+ * emits events, or registers routes.
+ */
+
+// ---------------------------------------------------------------------------
+// Closed vocabularies (contract §4). "unspecified" is always the default.
+// ---------------------------------------------------------------------------
+
+export const BOOKING_REASONS = [
+  'unspecified',
+  'comfort',
+  'relaxation',
+  'appearance',
+  'recurring_care',
+  'mobility_support',
+  'other_personal_goal',
+] as const;
+export type BookingReason = (typeof BOOKING_REASONS)[number];
+
+export const PRESSURE_PREFERENCES = ['unspecified', 'very_light', 'light', 'moderate', 'firm'] as const;
+export type PressurePreference = (typeof PRESSURE_PREFERENCES)[number];
+
+export const TOUCH_SENSITIVITIES = ['unspecified', 'low', 'medium', 'high'] as const;
+export type TouchSensitivity = (typeof TOUCH_SENSITIVITIES)[number];
+
+export const TEMPERATURE_PREFERENCES = ['unspecified', 'cooler', 'neutral', 'warmer'] as const;
+export type TemperaturePreference = (typeof TEMPERATURE_PREFERENCES)[number];
+
+export const FRAGRANCE_PREFERENCES = [
+  'unspecified',
+  'fragrance_free_required',
+  'light_fragrance_ok',
+  'no_preference',
+] as const;
+export type FragrancePreference = (typeof FRAGRANCE_PREFERENCES)[number];
+
+export const SENSITIVITY_FLAGS = [
+  'sensitive_skin',
+  'allergy_common_lotions',
+  'allergy_latex',
+  'neuropathy_care_attention',
+  'bruises_easily',
+] as const;
+export type SensitivityFlag = (typeof SENSITIVITY_FLAGS)[number];
+
+export const ACCESSIBILITY_NEEDS = [
+  'limited_mobility',
+  'uses_wheelchair',
+  'needs_seated_service',
+  'service_animal_present',
+  'stairs_at_entrance',
+] as const;
+export type AccessibilityNeed = (typeof ACCESSIBILITY_NEEDS)[number];
+
+export const SETTING_PREFERENCES = ['unspecified', 'at_home_only', 'studio_ok', 'either'] as const;
+export type SettingPreference = (typeof SETTING_PREFERENCES)[number];
+
+export const PREFERRED_DURATION_BUCKETS = ['unspecified', 'short_30_45', 'standard_60', 'extended_75_plus'] as const;
+export type PreferredDurationBucket = (typeof PREFERRED_DURATION_BUCKETS)[number];
+
+export const PREFERRED_TIME_WINDOWS = [
+  'weekday_morning',
+  'weekday_afternoon',
+  'weekday_evening',
+  'weekend_morning',
+  'weekend_afternoon',
+  'weekend_evening',
+] as const;
+export type PreferredTimeWindow = (typeof PREFERRED_TIME_WINDOWS)[number];
+
+export const COMMUNICATION_PREFERENCES = ['unspecified', 'chatty', 'quiet_visit', 'no_preference'] as const;
+export type CommunicationPreference = (typeof COMMUNICATION_PREFERENCES)[number];
+
+/** Curated BCP-47 list (contract §4 — curated, extensible at implementation review). */
+export const CURATED_LANGUAGE_TAGS = ['en', 'en-GB', 'es', 'fr', 'de', 'pt-BR', 'zh-Hans', 'hi', 'ar'] as const;
+
+export const VISIT_NOTE_MAX_LENGTH = 280;
+
+// ---------------------------------------------------------------------------
+// Visibility categories (contract §4). Default for every category: hidden.
+// ---------------------------------------------------------------------------
+
+export const VISIBILITY_CATEGORIES = [
+  'bookingReason',
+  'comfort',
+  'sensitivities',
+  'accessibility',
+  'setting',
+  'appointmentShape',
+  'communication',
+  'visitNote',
+] as const;
+export type VisibilityCategory = (typeof VISIBILITY_CATEGORIES)[number];
+
+export type ComfortVisibilityFlags = Record<VisibilityCategory, boolean>;
+
+/** Privacy by default — every category hidden until the client turns it on. */
+export function defaultVisibilityFlags(): ComfortVisibilityFlags {
+  return {
+    bookingReason: false,
+    comfort: false,
+    sensitivities: false,
+    accessibility: false,
+    setting: false,
+    appointmentShape: false,
+    communication: false,
+    visitNote: false,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Profile shape (all optional — contract §2.2 optional-everything)
+// ---------------------------------------------------------------------------
+
+export interface ComfortPreferences {
+  bookingReason?: BookingReason;
+  pressurePreference?: PressurePreference;
+  touchSensitivity?: TouchSensitivity;
+  temperaturePreference?: TemperaturePreference;
+  fragrancePreference?: FragrancePreference;
+  sensitivityFlags?: SensitivityFlag[];
+  accessibilityNeeds?: AccessibilityNeed[];
+  settingPreference?: SettingPreference;
+  preferredDurationBucket?: PreferredDurationBucket;
+  preferredTimeWindows?: PreferredTimeWindow[];
+  communicationPreference?: CommunicationPreference;
+  languagePreference?: string;
+  visitNote?: string;
+}
+
+const KNOWN_PREFERENCE_KEYS = new Set<string>([
+  'bookingReason',
+  'pressurePreference',
+  'touchSensitivity',
+  'temperaturePreference',
+  'fragrancePreference',
+  'sensitivityFlags',
+  'accessibilityNeeds',
+  'settingPreference',
+  'preferredDurationBucket',
+  'preferredTimeWindows',
+  'communicationPreference',
+  'languagePreference',
+  'visitNote',
+]);
+
+export interface ValidationIssue {
+  path: string;
+  message: string;
+}
+
+function isOneOf(value: unknown, allowed: readonly string[]): boolean {
+  return typeof value === 'string' && (allowed as readonly string[]).includes(value);
+}
+
+function validateMulti(
+  value: unknown,
+  allowed: readonly string[],
+  path: string,
+  issues: ValidationIssue[],
+): void {
+  if (value === undefined) return;
+  if (!Array.isArray(value)) {
+    issues.push({ path, message: 'must be an array' });
+    return;
+  }
+  const seen = new Set<string>();
+  for (const item of value) {
+    if (!isOneOf(item, allowed)) {
+      issues.push({ path, message: `unknown value: ${String(item)}` });
+    } else if (seen.has(item as string)) {
+      issues.push({ path, message: `duplicate value: ${String(item)}` });
+    } else {
+      seen.add(item as string);
+    }
+  }
+}
+
+/**
+ * Validates a raw preferences payload against the closed vocabularies.
+ * Unknown keys are rejected (contract §6 — "unknown keys rejected").
+ */
+export function validateComfortPreferences(raw: unknown): {
+  ok: boolean;
+  issues: ValidationIssue[];
+} {
+  const issues: ValidationIssue[] = [];
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
+    return { ok: false, issues: [{ path: '', message: 'preferences must be an object' }] };
+  }
+  const obj = raw as Record<string, unknown>;
+
+  for (const key of Object.keys(obj)) {
+    if (!KNOWN_PREFERENCE_KEYS.has(key)) {
+      issues.push({ path: key, message: 'unknown key rejected' });
+    }
+  }
+
+  const singles: Array<[string, readonly string[]]> = [
+    ['bookingReason', BOOKING_REASONS],
+    ['pressurePreference', PRESSURE_PREFERENCES],
+    ['touchSensitivity', TOUCH_SENSITIVITIES],
+    ['temperaturePreference', TEMPERATURE_PREFERENCES],
+    ['fragrancePreference', FRAGRANCE_PREFERENCES],
+    ['settingPreference', SETTING_PREFERENCES],
+    ['preferredDurationBucket', PREFERRED_DURATION_BUCKETS],
+    ['communicationPreference', COMMUNICATION_PREFERENCES],
+  ];
+  for (const [key, allowed] of singles) {
+    const value = obj[key];
+    if (value !== undefined && !isOneOf(value, allowed)) {
+      issues.push({ path: key, message: `value not in closed enum: ${String(value)}` });
+    }
+  }
+
+  validateMulti(obj['sensitivityFlags'], SENSITIVITY_FLAGS, 'sensitivityFlags', issues);
+  validateMulti(obj['accessibilityNeeds'], ACCESSIBILITY_NEEDS, 'accessibilityNeeds', issues);
+  validateMulti(obj['preferredTimeWindows'], PREFERRED_TIME_WINDOWS, 'preferredTimeWindows', issues);
+
+  const language = obj['languagePreference'];
+  if (language !== undefined && !isOneOf(language, CURATED_LANGUAGE_TAGS)) {
+    issues.push({ path: 'languagePreference', message: 'language tag not in curated list' });
+  }
+
+  const note = obj['visitNote'];
+  if (note !== undefined) {
+    if (typeof note !== 'string') {
+      issues.push({ path: 'visitNote', message: 'must be a string' });
+    } else if (note.length > VISIT_NOTE_MAX_LENGTH) {
+      issues.push({ path: 'visitNote', message: `exceeds ${VISIT_NOTE_MAX_LENGTH} characters` });
+    }
+  }
+
+  return { ok: issues.length === 0, issues };
+}
+
+/** Validates visibility flags: known categories only, booleans only. */
+export function validateVisibilityFlags(raw: unknown): { ok: boolean; issues: ValidationIssue[] } {
+  const issues: ValidationIssue[] = [];
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
+    return { ok: false, issues: [{ path: '', message: 'visibility must be an object' }] };
+  }
+  const obj = raw as Record<string, unknown>;
+  const known = new Set<string>(VISIBILITY_CATEGORIES);
+  for (const [key, value] of Object.entries(obj)) {
+    if (!known.has(key)) {
+      issues.push({ path: key, message: 'unknown visibility category rejected' });
+    } else if (typeof value !== 'boolean') {
+      issues.push({ path: key, message: 'must be a boolean' });
+    }
+  }
+  return { ok: issues.length === 0, issues };
+}
+
+// ---------------------------------------------------------------------------
+// Consent semantics (contract §2.7, §5)
+// ---------------------------------------------------------------------------
+
+export interface ComfortConsentRecord {
+  version: number;
+  consentTextHash: string;
+  grantedAt: string; // ISO 8601
+  withdrawnAt?: string | null;
+}
+
+/**
+ * Latest row wins; a latest row with withdrawnAt set means NO consent
+ * (contract §5). An empty history means no consent.
+ */
+export function isConsentActive(history: ComfortConsentRecord[]): boolean {
+  if (history.length === 0) return false;
+  const latest = [...history].sort((a, b) => a.grantedAt.localeCompare(b.grantedAt))[
+    history.length - 1
+  ];
+  return latest !== undefined && (latest.withdrawnAt === undefined || latest.withdrawnAt === null);
+}
+
+// ---------------------------------------------------------------------------
+// Provider projection (contract §2.6, §6)
+// ---------------------------------------------------------------------------
+
+/**
+ * Exact active-status set (contract §2.6): confirmed, en_route, in_progress.
+ * To be re-verified against docs/booking-statuses.md at implementation review.
+ */
+export const PROJECTION_ACTIVE_BOOKING_STATUSES = ['confirmed', 'en_route', 'in_progress'] as const;
+export type ProjectionActiveBookingStatus = (typeof PROJECTION_ACTIVE_BOOKING_STATUSES)[number];
+
+export function isProjectionEligibleStatus(status: string): boolean {
+  return (PROJECTION_ACTIVE_BOOKING_STATUSES as readonly string[]).includes(status);
+}
+
+export interface ComfortProjection {
+  bookingReason?: BookingReason;
+  comfort?: {
+    pressurePreference?: PressurePreference;
+    touchSensitivity?: TouchSensitivity;
+    temperaturePreference?: TemperaturePreference;
+    fragrancePreference?: FragrancePreference;
+  };
+  sensitivities?: SensitivityFlag[];
+  accessibility?: AccessibilityNeed[];
+  setting?: SettingPreference;
+  appointmentShape?: {
+    preferredDurationBucket?: PreferredDurationBucket;
+    preferredTimeWindows?: PreferredTimeWindow[];
+  };
+  communication?: {
+    communicationPreference?: CommunicationPreference;
+    languagePreference?: string;
+  };
+  visitNote?: string;
+}
+
+export interface ProjectionContext {
+  /** Booking is owned by the requesting provider. */
+  providerOwnsBooking: boolean;
+  /** Current booking status. */
+  bookingStatus: string;
+  /** Client's consent history (latest row wins). */
+  consentHistory: ComfortConsentRecord[];
+  /** Stored profile, if any. */
+  preferences: ComfortPreferences | null;
+  /** Stored per-category visibility flags. */
+  visibility: ComfortVisibilityFlags | null;
+}
+
+/**
+ * Pure projection function. Returns the filtered projection or null.
+ * A null result MUST surface as HTTP 404 (never 403) so the existence of a
+ * profile is never confirmed to an unauthorized caller (contract §6).
+ */
+export function buildProviderProjection(ctx: ProjectionContext): ComfortProjection | null {
+  if (!ctx.providerOwnsBooking) return null;
+  if (!isProjectionEligibleStatus(ctx.bookingStatus)) return null;
+  if (!isConsentActive(ctx.consentHistory)) return null;
+  if (ctx.preferences === null || ctx.visibility === null) return null;
+
+  const p = ctx.preferences;
+  const v = ctx.visibility;
+  const projection: ComfortProjection = {};
+
+  if (v.bookingReason && p.bookingReason !== undefined) {
+    projection.bookingReason = p.bookingReason;
+  }
+  if (v.comfort) {
+    const comfort: NonNullable<ComfortProjection['comfort']> = {};
+    if (p.pressurePreference !== undefined) comfort.pressurePreference = p.pressurePreference;
+    if (p.touchSensitivity !== undefined) comfort.touchSensitivity = p.touchSensitivity;
+    if (p.temperaturePreference !== undefined) comfort.temperaturePreference = p.temperaturePreference;
+    if (p.fragrancePreference !== undefined) comfort.fragrancePreference = p.fragrancePreference;
+    if (Object.keys(comfort).length > 0) projection.comfort = comfort;
+  }
+  if (v.sensitivities && p.sensitivityFlags !== undefined && p.sensitivityFlags.length > 0) {
+    projection.sensitivities = [...p.sensitivityFlags];
+  }
+  if (v.accessibility && p.accessibilityNeeds !== undefined && p.accessibilityNeeds.length > 0) {
+    projection.accessibility = [...p.accessibilityNeeds];
+  }
+  if (v.setting && p.settingPreference !== undefined) {
+    projection.setting = p.settingPreference;
+  }
+  if (v.appointmentShape) {
+    const shape: NonNullable<ComfortProjection['appointmentShape']> = {};
+    if (p.preferredDurationBucket !== undefined) shape.preferredDurationBucket = p.preferredDurationBucket;
+    if (p.preferredTimeWindows !== undefined && p.preferredTimeWindows.length > 0) {
+      shape.preferredTimeWindows = [...p.preferredTimeWindows];
+    }
+    if (Object.keys(shape).length > 0) projection.appointmentShape = shape;
+  }
+  if (v.communication) {
+    const comm: NonNullable<ComfortProjection['communication']> = {};
+    if (p.communicationPreference !== undefined) comm.communicationPreference = p.communicationPreference;
+    if (p.languagePreference !== undefined) comm.languagePreference = p.languagePreference;
+    if (Object.keys(comm).length > 0) projection.communication = comm;
+  }
+  if (v.visitNote && p.visitNote !== undefined && p.visitNote.length > 0) {
+    projection.visitNote = p.visitNote;
+  }
+
+  // Nothing visible → dark (surfaces as 404, never an empty card).
+  if (Object.keys(projection).length === 0) return null;
+  return projection;
+}
+
+// ---------------------------------------------------------------------------
+// Language rule (contract §2.8) — copy-audit helper
+// ---------------------------------------------------------------------------
+
+/** Phrases that must never appear in client- or provider-facing comfort copy. */
+export const FORBIDDEN_MEDICAL_PHRASES = [
+  'medically suitable',
+  'safe for your condition',
+  'recommended for your health',
+  'diagnos', // diagnose / diagnosis / diagnostic
+  'treatment for',
+] as const;
+
+export function findForbiddenMedicalPhrases(copy: string): string[] {
+  const lower = copy.toLowerCase();
+  return FORBIDDEN_MEDICAL_PHRASES.filter((phrase) => lower.includes(phrase));
+}
