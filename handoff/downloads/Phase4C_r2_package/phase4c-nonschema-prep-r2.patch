+/**
+ * Phase 4C — Comfort Profile — canonical fixtures for contract tests.
+ * Non-schema preparation artifact: pure data, no storage, no network.
+ */
+import type {
+  ComfortConsentRecord,
+  ComfortPreferences,
+  ComfortVisibilityFlags,
+  ProjectionContext,
+} from '../../contracts/comfort-profile.contract.js';
+import { defaultVisibilityFlags } from '../../contracts/comfort-profile.contract.js';
+
+// -- Preferences -------------------------------------------------------------
+
+/** A fully-populated, valid profile using only closed-enum values. */
+export const fullValidPreferences: ComfortPreferences = {
+  bookingReason: 'recurring_care',
+  pressurePreference: 'light',
+  touchSensitivity: 'high',
+  temperaturePreference: 'warmer',
+  fragrancePreference: 'fragrance_free_required',
+  sensitivityFlags: ['sensitive_skin', 'allergy_latex'],
+  accessibilityNeeds: ['limited_mobility', 'stairs_at_entrance'],
+  settingPreference: 'at_home_only',
+  preferredDurationBucket: 'standard_60',
+  preferredTimeWindows: ['weekday_morning', 'weekend_afternoon'],
+  communicationPreference: 'quiet_visit',
+  languagePreference: 'en',
+  visitNote: 'Please ring the bell twice; the front door sticks a little.',
+};
+
+/** Minimal valid payload — optional-everything means {} is valid. */
+export const emptyValidPreferences: ComfortPreferences = {};
+
+/** Invalid: value outside the closed enum. */
+export const invalidEnumPreferences = {
+  pressurePreference: 'deep_tissue_medical',
+} as const;
+
+/** Invalid: unknown key must be rejected. */
+export const unknownKeyPreferences = {
+  bookingReason: 'comfort',
+  medicalHistory: 'should never be accepted',
+} as const;
+
+/** Invalid: free-text note over the 280-character cap. */
+export const oversizedNotePreferences = {
+  visitNote: 'x'.repeat(281),
+} as const;
+
+/** Invalid: duplicate multi-select values. */
+export const duplicateFlagsPreferences = {
+  sensitivityFlags: ['sensitive_skin', 'sensitive_skin'],
+} as const;
+
+// -- Visibility ---------------------------------------------------------------
+
+export const allHiddenVisibility: ComfortVisibilityFlags = defaultVisibilityFlags();
+
+export const comfortAndAccessibilityVisible: ComfortVisibilityFlags = {
+  ...defaultVisibilityFlags(),
+  comfort: true,
+  accessibility: true,
+};
+
+export const everythingVisible: ComfortVisibilityFlags = {
+  bookingReason: true,
+  comfort: true,
+  sensitivities: true,
+  accessibility: true,
+  setting: true,
+  appointmentShape: true,
+  communication: true,
+  visitNote: true,
+};
+
+export const invalidVisibilityUnknownCategory = {
+  comfort: true,
+  medicalRecords: true,
+} as const;
+
+// -- Consent ------------------------------------------------------------------
+
+export const activeConsentHistory: ComfortConsentRecord[] = [
+  {
+    version: 1,
+    consentTextHash: 'a'.repeat(64),
+    grantedAt: '2026-08-01T10:00:00.000Z',
+    withdrawnAt: null,
+  },
+];
+
+export const withdrawnConsentHistory: ComfortConsentRecord[] = [
+  {
+    version: 1,
+    consentTextHash: 'a'.repeat(64),
+    grantedAt: '2026-08-01T10:00:00.000Z',
+    withdrawnAt: '2026-08-05T09:00:00.000Z',
+  },
+];
+
+/** Withdrawn, then re-granted — consent is active again (contract §2.7). */
+export const regrantedConsentHistory: ComfortConsentRecord[] = [
+  {
+    version: 1,
+    consentTextHash: 'a'.repeat(64),
+    grantedAt: '2026-08-01T10:00:00.000Z',
+    withdrawnAt: '2026-08-05T09:00:00.000Z',
+  },
+  {
+    version: 2,
+    consentTextHash: 'b'.repeat(64),
+    grantedAt: '2026-08-06T11:30:00.000Z',
+    withdrawnAt: null,
+  },
+];
+
+export const emptyConsentHistory: ComfortConsentRecord[] = [];
+
+// -- Projection scenarios -------------------------------------------------------
+
+export function projectionContext(overrides: Partial<ProjectionContext> = {}): ProjectionContext {
+  return {
+    providerOwnsBooking: true,
+    bookingStatus: 'confirmed',
+    consentHistory: activeConsentHistory,
+    preferences: fullValidPreferences,
+    visibility: comfortAndAccessibilityVisible,
+    ...overrides,
+  };
+}
+
+/** Booking statuses that must NEVER yield a projection (contract §2.6). */
+export const inactiveBookingStatuses = ['requested', 'completed', 'cancelled', 'declined'] as const;
