+/**
+ * Phase 4C — Client Comfort Preferences — UI SHELL (non-schema preparation).
+ *
+ * Presentational scaffold only:
+ *   - NOT wired into the router (see docs/comfort-profile/WIRING_NOTES.md)
+ *   - NO API calls, NO storage — all data flows through props/callbacks
+ *   - consent-first: editors stay locked until consent is granted
+ *   - privacy by default: every visibility toggle starts hidden
+ *
+ * Copy rule (contract §2.8): this screen only ever says what "matches your
+ * preferences" — it never uses medical-suitability phrasing.
+ */
+import React, { useState } from 'react';
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+import { Button } from '@/components/ui/button';
+import { Badge } from '@/components/ui/badge';
+import { Switch } from '@/components/ui/switch';
+import { Label } from '@/components/ui/label';
+import { Textarea } from '@/components/ui/textarea';
+import { Separator } from '@/components/ui/separator';
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@/components/ui/select';
+import { Eye, EyeOff, HeartHandshake, Lock, ShieldCheck, Undo2 } from 'lucide-react';
+
+// Closed vocabularies (mirrors artifacts/api-server/src/contracts/comfort-profile.contract.ts;
+// the generated client will replace these literals at implementation step C-1).
+const SINGLE_SELECTS: {
+  key: string;
+  label: string;
+  category: CategoryKey;
+  options: readonly string[];
+}[] = [
+  { key: 'bookingReason', label: 'Reason for booking', category: 'bookingReason', options: ['unspecified', 'comfort', 'relaxation', 'appearance', 'recurring_care', 'mobility_support', 'other_personal_goal'] },
+  { key: 'pressurePreference', label: 'Pressure', category: 'comfort', options: ['unspecified', 'very_light', 'light', 'moderate', 'firm'] },
+  { key: 'touchSensitivity', label: 'Touch sensitivity', category: 'comfort', options: ['unspecified', 'low', 'medium', 'high'] },
+  { key: 'temperaturePreference', label: 'Room temperature', category: 'comfort', options: ['unspecified', 'cooler', 'neutral', 'warmer'] },
+  { key: 'fragrancePreference', label: 'Fragrance', category: 'comfort', options: ['unspecified', 'fragrance_free_required', 'light_fragrance_ok', 'no_preference'] },
+  { key: 'settingPreference', label: 'Visit setting', category: 'setting', options: ['unspecified', 'at_home_only', 'studio_ok', 'either'] },
+  { key: 'preferredDurationBucket', label: 'Preferred duration', category: 'appointmentShape', options: ['unspecified', 'short_30_45', 'standard_60', 'extended_75_plus'] },
+  { key: 'communicationPreference', label: 'During the visit', category: 'communication', options: ['unspecified', 'chatty', 'quiet_visit', 'no_preference'] },
+];
+
+const MULTI_SELECTS: {
+  key: string;
+  label: string;
+  category: CategoryKey;
+  options: readonly string[];
+}[] = [
+  { key: 'sensitivityFlags', label: 'Sensitivities', category: 'sensitivities', options: ['sensitive_skin', 'allergy_common_lotions', 'allergy_latex', 'neuropathy_care_attention', 'bruises_easily'] },
+  { key: 'accessibilityNeeds', label: 'Accessibility', category: 'accessibility', options: ['limited_mobility', 'uses_wheelchair', 'needs_seated_service', 'service_animal_present', 'stairs_at_entrance'] },
+  { key: 'preferredTimeWindows', label: 'Preferred times', category: 'appointmentShape', options: ['weekday_morning', 'weekday_afternoon', 'weekday_evening', 'weekend_morning', 'weekend_afternoon', 'weekend_evening'] },
+];
+
+const CATEGORIES = [
+  { key: 'bookingReason', label: 'Reason for booking' },
+  { key: 'comfort', label: 'Comfort (pressure, touch, temperature, fragrance)' },
+  { key: 'sensitivities', label: 'Sensitivities' },
+  { key: 'accessibility', label: 'Accessibility' },
+  { key: 'setting', label: 'Visit setting' },
+  { key: 'appointmentShape', label: 'Appointment shape' },
+  { key: 'communication', label: 'Communication' },
+  { key: 'visitNote', label: 'Visit note' },
+] as const;
+type CategoryKey = (typeof CATEGORIES)[number]['key'];
+
+const VISIT_NOTE_MAX = 280;
+
+function humanize(value: string): string {
+  return value.replace(/_/g, ' ');
+}
+
+export interface ComfortPreferencesShellProps {
+  /** Current consent status (server-driven at C-3). */
+  consentStatus?: 'none' | 'active' | 'withdrawn';
+  /** Consent version + short copy shown on the consent card. */
+  consentVersion?: number;
+  consentCopy?: string;
+  /** Callbacks wired to the real API at C-3. */
+  onGrantConsent?: () => void;
+  onWithdrawConsent?: () => void;
+  onSave?: (draft: { preferences: Record<string, unknown>; visibility: Record<CategoryKey, boolean> }) => void;
+  onDeleteProfile?: () => void;
+  saving?: boolean;
+}
+
+export default function ComfortPreferencesShell({
+  consentStatus = 'none',
+  consentVersion = 1,
+  consentCopy = 'Comfort preferences are optional. You choose what is stored and which parts a provider can see — and only while they have an active booking with you. You can withdraw at any time, and withdrawal hides everything immediately.',
+  onGrantConsent,
+  onWithdrawConsent,
+  onSave,
+  onDeleteProfile,
+  saving = false,
+}: ComfortPreferencesShellProps) {
+  const consentActive = consentStatus === 'active';
+
+  const [single, setSingle] = useState<Record<string, string>>({});
+  const [multi, setMulti] = useState<Record<string, string[]>>({});
+  const [visitNote, setVisitNote] = useState('');
+  // Privacy by default — every category hidden until the client turns it on.
+  const [visibility, setVisibility] = useState<Record<CategoryKey, boolean>>({
+    bookingReason: false,
+    comfort: false,
+    sensitivities: false,
+    accessibility: false,
+    setting: false,
+    appointmentShape: false,
+    communication: false,
+    visitNote: false,
+  });
+
+  const toggleMulti = (key: string, option: string) => {
+    setMulti((prev) => {
+      const current = prev[key] ?? [];
+      return {
+        ...prev,
+        [key]: current.includes(option) ? current.filter((o) => o !== option) : [...current, option],
+      };
+    });
+  };
+
+  const handleSave = () => {
+    onSave?.({
+      preferences: { ...single, ...multi, ...(visitNote ? { visitNote } : {}) },
+      visibility,
+    });
+  };
+
+  return (
+    <div className="mx-auto w-full max-w-md space-y-4 p-4" data-testid="comfort-preferences-shell">
+      <header className="space-y-1">
+        <h1 className="flex items-center gap-2 text-xl font-semibold">
+          <HeartHandshake className="h-5 w-5" aria-hidden />
+          Comfort preferences
+        </h1>
+        <p className="text-sm text-muted-foreground">
+          Help visits feel right for you. Everything here is optional and never required to book.
+        </p>
+      </header>
+
+      {/* Consent-first card */}
+      <Card data-testid="comfort-consent-card">
+        <CardHeader>
+          <CardTitle className="flex items-center gap-2 text-base">
+            <ShieldCheck className="h-4 w-4" aria-hidden />
+            Your consent, first
+            <Badge variant="outline" data-testid="consent-version-badge">v{consentVersion}</Badge>
+          </CardTitle>
+          <CardDescription>{consentCopy}</CardDescription>
+        </CardHeader>
+        <CardContent className="flex flex-wrap gap-2">
+          {!consentActive ? (
+            <Button onClick={onGrantConsent} data-testid="grant-consent-button">
+              I agree — turn on comfort preferences
+            </Button>
+          ) : (
+            <Button
+              variant="outline"
+              onClick={onWithdrawConsent}
+              data-testid="withdraw-consent-button"
+            >
+              <Undo2 className="mr-1 h-4 w-4" aria-hidden />
+              Withdraw consent
+            </Button>
+          )}
+          {consentStatus === 'withdrawn' && (
+            <p className="w-full text-xs text-muted-foreground" data-testid="withdrawn-explainer">
+              Consent withdrawn — providers can no longer see any preferences. Re-granting brings
+              your saved choices back.
+            </p>
+          )}
+        </CardContent>
+      </Card>
+
+      {/* Editors — locked until consent */}
+      <div className={consentActive ? '' : 'pointer-events-none select-none opacity-50'} aria-disabled={!consentActive}>
+        {!consentActive && (
+          <p className="mb-2 flex items-center gap-1 text-xs text-muted-foreground" data-testid="editors-locked-note">
+            <Lock className="h-3 w-3" aria-hidden /> Grant consent above to edit your preferences.
+          </p>
+        )}
+
+        <Card>
+          <CardHeader>
+            <CardTitle className="text-base">Your preferences</CardTitle>
+            <CardDescription>
+              A provider with an active booking sees only what you make visible — shown to them as
+              what matches your preferences, nothing more.
+            </CardDescription>
+          </CardHeader>
+          <CardContent className="space-y-4">
+            {SINGLE_SELECTS.map((field) => (
+              <div key={field.key} className="space-y-1">
+                <Label htmlFor={`comfort-${field.key}`}>{field.label}</Label>
+                <Select
+                  value={single[field.key] ?? 'unspecified'}
+                  onValueChange={(value) => setSingle((prev) => ({ ...prev, [field.key]: value }))}
+                >
+                  <SelectTrigger id={`comfort-${field.key}`} data-testid={`select-${field.key}`}>
+                    <SelectValue placeholder="unspecified" />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {field.options.map((option) => (
+                      <SelectItem key={option} value={option}>
+                        {humanize(option)}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              </div>
+            ))}
+
+            <Separator />
+
+            {MULTI_SELECTS.map((field) => (
+              <div key={field.key} className="space-y-1">
+                <Label>{field.label}</Label>
+                <div className="flex flex-wrap gap-2">
+                  {field.options.map((option) => {
+                    const selected = (multi[field.key] ?? []).includes(option);
+                    return (
+                      <Badge
+                        key={option}
+                        variant={selected ? 'default' : 'outline'}
+                        className="cursor-pointer"
+                        onClick={() => toggleMulti(field.key, option)}
+                        data-testid={`chip-${field.key}-${option}`}
+                      >
+                        {humanize(option)}
+                      </Badge>
+                    );
+                  })}
+                </div>
+              </div>
+            ))}
+
+            <Separator />
+
+            <div className="space-y-1">
+              <Label htmlFor="comfort-visit-note">Anything else for your visit? (optional)</Label>
+              <Textarea
+                id="comfort-visit-note"
+                data-testid="visit-note-input"
+                value={visitNote}
+                maxLength={VISIT_NOTE_MAX}
+                onChange={(event) => setVisitNote(event.target.value.slice(0, VISIT_NOTE_MAX))}
+                placeholder="e.g. the doorbell is broken — please knock"
+              />
+              <p className="text-right text-xs text-muted-foreground">
+                {visitNote.length}/{VISIT_NOTE_MAX} · not for sensitive details · hidden unless you
+                make “Visit note” visible below
+              </p>
+            </div>
+          </CardContent>
+        </Card>
+
+        {/* Per-category visibility */}
+        <Card className="mt-4">
+          <CardHeader>
+            <CardTitle className="text-base">What can a provider see?</CardTitle>
+            <CardDescription>
+              Everything starts hidden. Turn on only what you want shared during an active booking.
+            </CardDescription>
+          </CardHeader>
+          <CardContent className="space-y-3">
+            {CATEGORIES.map((category) => (
+              <div key={category.key} className="flex items-center justify-between gap-3">
+                <Label htmlFor={`visibility-${category.key}`} className="flex items-center gap-2 text-sm font-normal">
+                  {visibility[category.key] ? (
+                    <Eye className="h-4 w-4 text-foreground" aria-hidden />
+                  ) : (
+                    <EyeOff className="h-4 w-4 text-muted-foreground" aria-hidden />
+                  )}
+                  {category.label}
+                </Label>
+                <Switch
+                  id={`visibility-${category.key}`}
+                  data-testid={`visibility-${category.key}`}
+                  checked={visibility[category.key]}
+                  onCheckedChange={(checked) =>
+                    setVisibility((prev) => ({ ...prev, [category.key]: checked }))
+                  }
+                />
+              </div>
+            ))}
+          </CardContent>
+        </Card>
+
+        <div className="mt-4 flex flex-wrap gap-2">
+          <Button onClick={handleSave} disabled={!consentActive || saving} data-testid="save-preferences-button">
+            {saving ? 'Saving…' : 'Save preferences'}
+          </Button>
+          <Button
+            variant="ghost"
+            className="text-destructive"
+            onClick={onDeleteProfile}
+            disabled={!consentActive}
+            data-testid="delete-profile-button"
+          >
+            Delete my comfort profile
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
