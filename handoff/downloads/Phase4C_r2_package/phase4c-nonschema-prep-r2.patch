+/**
+ * Phase 4C — Provider booking detail — "Client comfort preferences" CARD SHELL.
+ *
+ * Presentational scaffold only (non-schema preparation):
+ *   - NOT wired into booking-detail; rendered only when a projection is passed
+ *   - renders NOTHING (not even an empty card) when there is no data — the
+ *     server-side projection is the only authority on what is visible
+ *   - copy rule: this card only ever describes what matches your preferences
+ *     for the visit; it never provides medical guidance
+ */
+import React from 'react';
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+import { Badge } from '@/components/ui/badge';
+import { HeartHandshake } from 'lucide-react';
+
+export interface ComfortProjectionView {
+  bookingReason?: string;
+  comfort?: {
+    pressurePreference?: string;
+    touchSensitivity?: string;
+    temperaturePreference?: string;
+    fragrancePreference?: string;
+  };
+  sensitivities?: string[];
+  accessibility?: string[];
+  setting?: string;
+  appointmentShape?: {
+    preferredDurationBucket?: string;
+    preferredTimeWindows?: string[];
+  };
+  communication?: {
+    communicationPreference?: string;
+    languagePreference?: string;
+  };
+  visitNote?: string;
+}
+
+function humanize(value: string): string {
+  return value.replace(/_/g, ' ');
+}
+
+function ChipRow({ label, values }: { label: string; values: string[] }) {
+  if (values.length === 0) return null;
+  return (
+    <div className="space-y-1">
+      <p className="text-xs font-medium text-muted-foreground">{label}</p>
+      <div className="flex flex-wrap gap-1">
+        {values.map((value) => (
+          <Badge key={value} variant="secondary">
+            {humanize(value)}
+          </Badge>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+export default function ProviderComfortCardShell({
+  projection,
+}: {
+  /** Server-filtered projection; when absent the card renders nothing at all. */
+  projection?: ComfortProjectionView | null;
+}) {
+  // No data → no card, no empty state, no hint that a profile exists.
+  if (!projection || Object.keys(projection).length === 0) return null;
+
+  const comfortChips: string[] = [];
+  if (projection.comfort?.pressurePreference) comfortChips.push(`${projection.comfort.pressurePreference} pressure`);
+  if (projection.comfort?.touchSensitivity) comfortChips.push(`${projection.comfort.touchSensitivity} touch sensitivity`);
+  if (projection.comfort?.temperaturePreference) comfortChips.push(`${projection.comfort.temperaturePreference} room`);
+  if (projection.comfort?.fragrancePreference) comfortChips.push(projection.comfort.fragrancePreference);
+
+  const shapeChips: string[] = [];
+  if (projection.appointmentShape?.preferredDurationBucket) {
+    shapeChips.push(projection.appointmentShape.preferredDurationBucket);
+  }
+  for (const window of projection.appointmentShape?.preferredTimeWindows ?? []) {
+    shapeChips.push(window);
+  }
+
+  const communicationChips: string[] = [];
+  if (projection.communication?.communicationPreference) {
+    communicationChips.push(projection.communication.communicationPreference);
+  }
+  if (projection.communication?.languagePreference) {
+    communicationChips.push(`language: ${projection.communication.languagePreference}`);
+  }
+
+  return (
+    <Card data-testid="provider-comfort-card">
+      <CardHeader>
+        <CardTitle className="flex items-center gap-2 text-base">
+          <HeartHandshake className="h-4 w-4" aria-hidden />
+          Client comfort preferences
+        </CardTitle>
+        <CardDescription>
+          What matches your preferences for this visit, shared by the client for this active
+          booking only.
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="space-y-3">
+        {projection.bookingReason && (
+          <ChipRow label="Reason for booking" values={[projection.bookingReason]} />
+        )}
+        <ChipRow label="Comfort" values={comfortChips} />
+        <ChipRow label="Sensitivities" values={projection.sensitivities ?? []} />
+        <ChipRow label="Accessibility" values={projection.accessibility ?? []} />
+        {projection.setting && <ChipRow label="Visit setting" values={[projection.setting]} />}
+        <ChipRow label="Appointment shape" values={shapeChips} />
+        <ChipRow label="Communication" values={communicationChips} />
+        {projection.visitNote && (
+          <div className="space-y-1" data-testid="projected-visit-note">
+            <p className="text-xs font-medium text-muted-foreground">Visit note from the client</p>
+            <p className="rounded-md bg-muted p-2 text-sm">{projection.visitNote}</p>
+          </div>
+        )}
+      </CardContent>
+    </Card>
+  );
+}
