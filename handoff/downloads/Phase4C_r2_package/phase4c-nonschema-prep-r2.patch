+/**
+ * Phase 4C — Comfort Profile — CONTRACT TESTS (non-schema preparation).
+ *
+ * Pure tests: no database, no server, no network. They pin the contract
+ * semantics (closed enums, privacy-by-default visibility, consent latest-row
+ * semantics, booking-scoped projection filtering, 404-never-403 darkness,
+ * language rule, and OpenAPI draft coverage) before any implementation.
+ */
+import { strict as assert } from 'node:assert';
+import { test } from 'node:test';
+import { readFileSync } from 'node:fs';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import {
+  ACCESSIBILITY_NEEDS,
+  BOOKING_REASONS,
+  COMMUNICATION_PREFERENCES,
+  FRAGRANCE_PREFERENCES,
+  PREFERRED_DURATION_BUCKETS,
+  PREFERRED_TIME_WINDOWS,
+  PRESSURE_PREFERENCES,
+  PROJECTION_ACTIVE_BOOKING_STATUSES,
+  SENSITIVITY_FLAGS,
+  SETTING_PREFERENCES,
+  TOUCH_SENSITIVITIES,
+  VISIBILITY_CATEGORIES,
+  VISIT_NOTE_MAX_LENGTH,
+  buildProviderProjection,
+  defaultVisibilityFlags,
+  findForbiddenMedicalPhrases,
+  isConsentActive,
+  validateComfortPreferences,
+  validateVisibilityFlags,
+} from '../contracts/comfort-profile.contract.js';
+import {
+  activeConsentHistory,
+  allHiddenVisibility,
+  comfortAndAccessibilityVisible,
+  duplicateFlagsPreferences,
+  emptyConsentHistory,
+  emptyValidPreferences,
+  everythingVisible,
+  fullValidPreferences,
+  inactiveBookingStatuses,
+  invalidEnumPreferences,
+  invalidVisibilityUnknownCategory,
+  oversizedNotePreferences,
+  projectionContext,
+  regrantedConsentHistory,
+  unknownKeyPreferences,
+  withdrawnConsentHistory,
+} from './fixtures/comfort-profile.fixtures.js';
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+const REPO_ROOT = join(__dirname, '..', '..', '..', '..');
+
+// ---------------------------------------------------------------------------
+
+test('Closed vocabularies', async (t) => {
+  await t.test('every optional single-select enum starts with "unspecified"', () => {
+    for (const vocab of [
+      BOOKING_REASONS,
+      PRESSURE_PREFERENCES,
+      TOUCH_SENSITIVITIES,
+      SETTING_PREFERENCES,
+      PREFERRED_DURATION_BUCKETS,
+      COMMUNICATION_PREFERENCES,
+      FRAGRANCE_PREFERENCES,
+    ]) {
+      assert.equal(vocab[0], 'unspecified');
+    }
+  });
+
+  await t.test('vocabulary sizes match the v3 contract exactly', () => {
+    assert.equal(BOOKING_REASONS.length, 7); // unspecified + 6
+    assert.equal(PRESSURE_PREFERENCES.length, 5);
+    assert.equal(TOUCH_SENSITIVITIES.length, 4);
+    assert.equal(FRAGRANCE_PREFERENCES.length, 4);
+    assert.equal(SENSITIVITY_FLAGS.length, 5);
+    assert.equal(ACCESSIBILITY_NEEDS.length, 5);
+    assert.equal(SETTING_PREFERENCES.length, 4);
+    assert.equal(PREFERRED_DURATION_BUCKETS.length, 4);
+    assert.equal(PREFERRED_TIME_WINDOWS.length, 6);
+    assert.equal(COMMUNICATION_PREFERENCES.length, 4);
+    assert.equal(VISIBILITY_CATEGORIES.length, 8);
+    assert.equal(VISIT_NOTE_MAX_LENGTH, 280);
+  });
+
+  await t.test('full valid fixture passes validation', () => {
+    const result = validateComfortPreferences(fullValidPreferences);
+    assert.deepEqual(result.issues, []);
+    assert.equal(result.ok, true);
+  });
+
+  await t.test('optional-everything: empty object is a valid profile payload', () => {
+    assert.equal(validateComfortPreferences(emptyValidPreferences).ok, true);
+  });
+
+  await t.test('out-of-enum value is rejected', () => {
+    const result = validateComfortPreferences(invalidEnumPreferences);
+    assert.equal(result.ok, false);
+    assert.ok(result.issues.some((i) => i.path === 'pressurePreference'));
+  });
+
+  await t.test('unknown keys are rejected', () => {
+    const result = validateComfortPreferences(unknownKeyPreferences);
+    assert.equal(result.ok, false);
+    assert.ok(result.issues.some((i) => i.path === 'medicalHistory'));
+  });
+
+  await t.test('visit note over 280 chars is rejected', () => {
+    const result = validateComfortPreferences(oversizedNotePreferences);
+    assert.equal(result.ok, false);
+    assert.ok(result.issues.some((i) => i.path === 'visitNote'));
+  });
+
+  await t.test('duplicate multi-select values are rejected', () => {
+    const result = validateComfortPreferences(duplicateFlagsPreferences);
+    assert.equal(result.ok, false);
+  });
+});
+
+// ---------------------------------------------------------------------------
+
+test('Visibility semantics', async (t) => {
+  await t.test('privacy by default: every category starts hidden', () => {
+    const flags = defaultVisibilityFlags();
+    for (const category of VISIBILITY_CATEGORIES) {
+      assert.equal(flags[category], false, `${category} must default to hidden`);
+    }
+  });
+
+  await t.test('unknown visibility categories are rejected', () => {
+    const result = validateVisibilityFlags(invalidVisibilityUnknownCategory);
+    assert.equal(result.ok, false);
+    assert.ok(result.issues.some((i) => i.path === 'medicalRecords'));
+  });
+
+  await t.test('valid visibility flags pass', () => {
+    assert.equal(validateVisibilityFlags(everythingVisible).ok, true);
+    assert.equal(validateVisibilityFlags(allHiddenVisibility).ok, true);
+  });
+});
+
+// ---------------------------------------------------------------------------
+
+test('Consent semantics (latest row wins)', async (t) => {
+  await t.test('no history means no consent', () => {
+    assert.equal(isConsentActive(emptyConsentHistory), false);
+  });
+
+  await t.test('granted and not withdrawn means active', () => {
+    assert.equal(isConsentActive(activeConsentHistory), true);
+  });
+
+  await t.test('withdrawn latest row means NO consent', () => {
+    assert.equal(isConsentActive(withdrawnConsentHistory), false);
+  });
+
+  await t.test('withdrawal is reversible by re-granting', () => {
+    assert.equal(isConsentActive(regrantedConsentHistory), true);
+  });
+});
+
+// ---------------------------------------------------------------------------
+
+test('Provider projection filtering', async (t) => {
+  await t.test('active booking + consent + visible categories yields only those categories', () => {
+    const projection = buildProviderProjection(projectionContext());
+    assert.ok(projection);
+    // comfort + accessibility visible in the fixture
+    assert.ok(projection.comfort);
+    assert.deepEqual(projection.accessibility, ['limited_mobility', 'stairs_at_entrance']);
+    // hidden categories are entirely absent — not empty, absent
+    assert.equal('bookingReason' in projection, false);
+    assert.equal('sensitivities' in projection, false);
+    assert.equal('visitNote' in projection, false);
+    assert.equal('communication' in projection, false);
+  });
+
+  await t.test('provider who does not own the booking gets darkness (→404, never 403)', () => {
+    assert.equal(buildProviderProjection(projectionContext({ providerOwnsBooking: false })), null);
+  });
+
+  await t.test('exact active-status set is confirmed/en_route/in_progress', () => {
+    assert.deepEqual([...PROJECTION_ACTIVE_BOOKING_STATUSES], ['confirmed', 'en_route', 'in_progress']);
+    for (const status of PROJECTION_ACTIVE_BOOKING_STATUSES) {
+      assert.ok(buildProviderProjection(projectionContext({ bookingStatus: status })));
+    }
+  });
+
+  await t.test('requested/completed/cancelled bookings never yield a projection', () => {
+    for (const status of inactiveBookingStatuses) {
+      assert.equal(buildProviderProjection(projectionContext({ bookingStatus: status })), null, status);
+    }
+  });
+
+  await t.test('withdrawn consent makes the projection go dark immediately', () => {
+    assert.equal(
+      buildProviderProjection(projectionContext({ consentHistory: withdrawnConsentHistory })),
+      null,
+    );
+  });
+
+  await t.test('re-granted consent restores the projection', () => {
+    assert.ok(buildProviderProjection(projectionContext({ consentHistory: regrantedConsentHistory })));
+  });
+
+  await t.test('all categories hidden yields darkness, not an empty object', () => {
+    assert.equal(
+      buildProviderProjection(projectionContext({ visibility: allHiddenVisibility })),
+      null,
+    );
+  });
+
+  await t.test('missing profile yields darkness', () => {
+    assert.equal(
+      buildProviderProjection(projectionContext({ preferences: null, visibility: null })),
+      null,
+    );
+  });
+
+  await t.test('visit note is projected only when its category is explicitly visible', () => {
+    const withNoteVisible = buildProviderProjection(
+      projectionContext({ visibility: { ...comfortAndAccessibilityVisible, visitNote: true } }),
+    );
+    assert.ok(withNoteVisible);
+    assert.equal(typeof withNoteVisible.visitNote, 'string');
+
+    const withNoteHidden = buildProviderProjection(projectionContext());
+    assert.ok(withNoteHidden);
+    assert.equal('visitNote' in withNoteHidden, false);
+  });
+});
+
+// ---------------------------------------------------------------------------
+
+test('Language rule — copy audit', async (t) => {
+  await t.test('detector catches medical-suitability phrasing', () => {
+    assert.deepEqual(findForbiddenMedicalPhrases('This service is medically suitable for you'), [
+      'medically suitable',
+    ]);
+    assert.deepEqual(findForbiddenMedicalPhrases('matches your preferences'), []);
+  });
+
+  await t.test('UI shells contain zero forbidden medical phrases', () => {
+    const shellFiles = [
+      join(REPO_ROOT, 'artifacts/web/src/pages/comfort/comfort-preferences-shell.tsx'),
+      join(REPO_ROOT, 'artifacts/web/src/components/comfort/provider-comfort-card-shell.tsx'),
+    ];
+    for (const file of shellFiles) {
+      const source = readFileSync(file, 'utf8');
+      assert.deepEqual(findForbiddenMedicalPhrases(source), [], file);
+    }
+  });
+
+  await t.test('provider-facing shell uses "matches your preferences" copy', () => {
+    const source = readFileSync(
+      join(REPO_ROOT, 'artifacts/web/src/components/comfort/provider-comfort-card-shell.tsx'),
+      'utf8',
+    );
+    assert.ok(source.toLowerCase().includes('matches your preferences'));
+  });
+});
+
+// ---------------------------------------------------------------------------
+
+test('OpenAPI draft coverage', async (t) => {
+  const draft = readFileSync(join(REPO_ROOT, 'docs/comfort-profile/openapi.draft.yaml'), 'utf8');
+
+  await t.test('draft is marked as draft and pinned to the verified contract checksum', () => {
+    assert.ok(draft.includes('x-status: draft'));
+    assert.ok(
+      draft.includes('339a03e6bb2c7aab6cee7306bb1daff43003a46c6edbbf16f2ed77c2d5fe4a4f'),
+    );
+  });
+
+  await t.test('all six contract routes are present', () => {
+    assert.ok(draft.includes('/clients/me/comfort-profile:'));
+    assert.ok(draft.includes('/clients/me/comfort-consent:'));
+    assert.ok(draft.includes('/bookings/{bookingId}/client-comfort:'));
+    for (const op of [
+      'getMyComfortProfile',
+      'putMyComfortProfile',
+      'deleteMyComfortProfile',
+      'grantComfortConsent',
+      'withdrawComfortConsent',
+      'getBookingClientComfort',
+    ]) {
+      assert.ok(draft.includes(`operationId: ${op}`), op);
+    }
+  });
+
+  await t.test('every closed enum value appears in the draft spec', () => {
+    const vocabularies: readonly (readonly string[])[] = [
+      BOOKING_REASONS,
+      PRESSURE_PREFERENCES,
+      TOUCH_SENSITIVITIES,
+      FRAGRANCE_PREFERENCES,
+      SENSITIVITY_FLAGS,
+      ACCESSIBILITY_NEEDS,
+      SETTING_PREFERENCES,
+      PREFERRED_DURATION_BUCKETS,
+      PREFERRED_TIME_WINDOWS,
+      COMMUNICATION_PREFERENCES,
+    ];
+    for (const vocab of vocabularies) {
+      for (const value of vocab) {
+        assert.ok(draft.includes(value), `missing enum value in draft: ${value}`);
+      }
+    }
+  });
+
+  await t.test('projection denial documents 404-never-403 and note cap is 280', () => {
+    assert.ok(draft.toLowerCase().includes('never 403'));
+    assert.ok(draft.includes('maxLength: 280'));
+  });
+
+  await t.test('draft contains no medical-suitability phrasing', () => {
+    assert.deepEqual(findForbiddenMedicalPhrases(draft), []);
+  });
+});
