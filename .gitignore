# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# pnpm local content-addressable store
.pnpm-store/

# Emergent platform (local tooling, not app code)
.emergent/

# Emergent agent working memory (local only)
memory/
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Uploaded prompts and temporary handoff files stay in the workspace only
/attached_assets/Pasted-*.txt
/attached_assets/*.patch

# API server runtime DLQ/reconciliation output (written at runtime by
# prevented-booking-events; tracking it trips the Session-080 scope guard)
artifacts/api-server/var/

# External test-harness reports (agent tooling output, not repository artifacts)
/test_reports/

# Graphify local-only cache/cost data (portable graph artifacts ARE committed)
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_root
