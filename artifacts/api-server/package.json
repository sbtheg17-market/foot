{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "node --enable-source-maps --import tsx/esm ./src/seed.ts",
    "backfill:role-state": "node --enable-source-maps --import tsx/esm ./src/scripts/backfill-role-state.ts",
    "replay:prevented-bookings": "node --enable-source-maps --import tsx/esm ./src/scripts/replay-prevented-bookings.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test src/__tests__/booking-state-machine.test.ts",
    "test:integration": "node --import tsx/esm --test src/__tests__/booking-concurrency.test.ts",
    "test:lifecycle": "node --import tsx/esm --test src/__tests__/client-booking-lifecycle.integration.test.ts",
    "test:reviews": "node --import tsx/esm --test src/__tests__/review.integration.test.ts",
    "test:care-history": "node --import tsx/esm --test src/__tests__/care-history.integration.test.ts",
    "test:role-state": "node --import tsx/esm --test src/__tests__/role-state.integration.test.ts",
    "test:authorization": "node --import tsx/esm --test src/__tests__/authorization-hardening.integration.test.ts",
    "test:provider-application": "node --import tsx/esm --test src/__tests__/provider-application.integration.test.ts",
    "test:provider-resubmission": "node --import tsx/esm --test src/__tests__/provider-application-resubmission.integration.test.ts",
    "test:provider-status": "node --import tsx/esm --test src/__tests__/provider-application-status.integration.test.ts",
    "test:availability": "node --import tsx/esm --test src/__tests__/availability-preset.test.ts",
    "test:pressure": "node --import tsx/esm --test src/__tests__/booking-pressure.test.ts",
    "test:onboarding": "node --import tsx/esm --test src/__tests__/provider-application-completion.integration.test.ts",
    "test:provider-history": "node --import tsx/esm --test src/__tests__/provider-application-history.integration.test.ts",
    "test:provider-notifications": "node --import tsx/esm --test src/__tests__/provider-notifications.integration.test.ts",
    "test:reviewer-decisions": "node --import tsx/esm --test src/__tests__/reviewer-decisions.integration.test.ts",
    "test:provider-readiness": "node --import tsx/esm --test src/__tests__/provider-readiness.integration.test.ts",
    "test:first-booking": "node --import tsx/esm --test src/__tests__/first-booking-signal.integration.test.ts",
    "test:client-retention": "node --import tsx/esm --test src/__tests__/client-retention.integration.test.ts",
    "test:marketplace-events": "node --import tsx/esm --test src/__tests__/marketplace-events.integration.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "expo-server-sdk": "^7.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
