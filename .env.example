# ============================================================
# OnCall Foot — Environment Variables
# Copy to .env and fill in values before running locally.
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/oncallfoot

# --- Auth ---
# Secret key for signing JWT tokens. Use a long random string.
JWT_SECRET=change-me-use-a-long-random-string
# Token expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Sessions (optional, if cookie sessions added later) ---
SESSION_SECRET=change-me-session-secret

# --- Future: Stripe (do not add real keys until ready) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
