+/**
+ * Phase 4C — Comfort profile DEMO HARNESS — fixture data only, nothing persists.
+ *
+ * Local wiring of the two Phase 4C shells so the consent-first flow and the
+ * booking-scoped provider projection can be exercised end to end WITHOUT any
+ * API, storage, schema, codegen, or event work:
+ *
+ *   Client pane   → ComfortPreferencesShell (grant/withdraw consent, edit,
+ *                   save, delete — all in React memory)
+ *   Provider pane → ProviderComfortCardShell fed by the pure projection
+ *                   mirror over the SAVED (not draft) profile
+ *
+ * Demo-only route (/comfort-demo); removed/replaced at step C-3 when the
+ * server projection becomes the single authority.
+ */
+import React, { useMemo, useState } from 'react';
+import ComfortPreferencesShell from './comfort-preferences-shell';
+import ProviderComfortCardShell from '@/components/comfort/provider-comfort-card-shell';
+import {
+  ALL_DEMO_BOOKING_STATUSES,
+  ACTIVE_BOOKING_STATUSES,
+  SAMPLE_PREFERENCES,
+  SAMPLE_VISIBILITY,
+  buildDemoProjection,
+  type DemoBookingStatus,
+  type DemoPreferences,
+  type VisibilityFlags,
+} from './comfort-demo-data';
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import { Label } from '@/components/ui/label';
+import { Switch } from '@/components/ui/switch';
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@/components/ui/select';
+import { FlaskConical, MoonStar, UserRound, Sparkles } from 'lucide-react';
+import { toast } from 'sonner';
+
+type ConsentStatus = 'none' | 'active' | 'withdrawn';
+
+export default function ComfortDemo() {
+  // ── client-side demo state (in-memory only) ────────────────────────
+  const [consentStatus, setConsentStatus] = useState<ConsentStatus>('none');
+  const [savedPreferences, setSavedPreferences] = useState<DemoPreferences | null>(null);
+  const [savedVisibility, setSavedVisibility] = useState<VisibilityFlags | null>(null);
+  const [seed, setSeed] = useState(0); // remount key for "Load sample profile"
+  const [seeded, setSeeded] = useState(false);
+
+  // ── provider-side booking simulation ──────────────────────────────
+  const [bookingStatus, setBookingStatus] = useState<DemoBookingStatus>('confirmed');
+  const [providerOwnsBooking, setProviderOwnsBooking] = useState(true);
+
+  const projection = useMemo(
+    () =>
+      buildDemoProjection({
+        providerOwnsBooking,
+        bookingStatus,
+        consentActive: consentStatus === 'active',
+        preferences: savedPreferences,
+        visibility: savedVisibility,
+      }),
+    [providerOwnsBooking, bookingStatus, consentStatus, savedPreferences, savedVisibility],
+  );
+
+  const handleGrant = () => {
+    setConsentStatus('active');
+    toast.success('Consent granted — your preferences are now editable.');
+  };
+  const handleWithdraw = () => {
+    setConsentStatus('withdrawn');
+    toast.info('Consent withdrawn — providers can no longer see any preferences.');
+  };
+  const handleSave = (draft: { preferences: Record<string, unknown>; visibility: VisibilityFlags }) => {
+    setSavedPreferences(draft.preferences as DemoPreferences);
+    setSavedVisibility(draft.visibility);
+    toast.success('Preferences saved (demo memory only — nothing persists).');
+  };
+  const handleDelete = () => {
+    setSavedPreferences(null);
+    setSavedVisibility(null);
+    setSeeded(false);
+    setSeed((s) => s + 1); // clear the editor too
+    toast.info('Comfort profile deleted. Consent history is kept.');
+  };
+  const loadSample = () => {
+    setSeeded(true);
+    setSeed((s) => s + 1);
+    setSavedPreferences(SAMPLE_PREFERENCES);
+    setSavedVisibility(SAMPLE_VISIBILITY);
+    if (consentStatus !== 'active') setConsentStatus('active');
+    toast.success('Sample fixture profile loaded (comfort + accessibility visible).');
+  };
+
+  const isActiveStatus = (ACTIVE_BOOKING_STATUSES as readonly string[]).includes(bookingStatus);
+
+  return (
+    <div className="min-h-screen bg-background text-foreground">
+      <div className="mx-auto w-full max-w-6xl space-y-4 p-4">
+        {/* Demo banner */}
+        <Card className="border-dashed" data-testid="comfort-demo-banner">
+          <CardHeader>
+            <CardTitle className="flex flex-wrap items-center gap-2 text-base">
+              <FlaskConical className="h-4 w-4" aria-hidden />
+              Phase 4C comfort profile — local demo harness
+              <Badge variant="outline">fixture data only</Badge>
+              <Badge variant="outline">nothing persists</Badge>
+            </CardTitle>
+            <CardDescription>
+              Everything on this page lives in memory: no API, no database, no analytics. The
+              provider pane applies the same filtering rules the server will enforce — a provider
+              only ever sees what matches your preferences, and only during an active booking.
+            </CardDescription>
+          </CardHeader>
+          <CardContent>
+            <Button size="sm" variant="secondary" onClick={loadSample} data-testid="load-sample-button">
+              <Sparkles className="mr-1 h-4 w-4" aria-hidden />
+              Load sample fixture profile
+            </Button>
+          </CardContent>
+        </Card>
+
+        <div className="grid gap-4 lg:grid-cols-2">
+          {/* ── Client pane ── */}
+          <section aria-label="Client view" className="rounded-lg border">
+            <div className="flex items-center gap-2 border-b px-4 py-2 text-sm font-medium">
+              <UserRound className="h-4 w-4" aria-hidden /> Client view
+            </div>
+            <ComfortPreferencesShell
+              key={seed}
+              consentStatus={consentStatus}
+              onGrantConsent={handleGrant}
+              onWithdrawConsent={handleWithdraw}
+              onSave={handleSave}
+              onDeleteProfile={handleDelete}
+              initialPreferences={seeded ? (SAMPLE_PREFERENCES as Record<string, unknown>) : undefined}
+              initialVisibility={seeded ? SAMPLE_VISIBILITY : undefined}
+            />
+          </section>
+
+          {/* ── Provider pane ── */}
+          <section aria-label="Provider view" className="space-y-4">
+            <Card>
+              <CardHeader>
+                <CardTitle className="text-base">Provider view — booking simulation</CardTitle>
+                <CardDescription>
+                  The card below appears only while the booking is active (confirmed, en route or
+                  in progress), the provider owns the booking, consent is active, and at least one
+                  category is visible. Otherwise the server answers 404 — never 403 — and nothing
+                  renders at all.
+                </CardDescription>
+              </CardHeader>
+              <CardContent className="space-y-3">
+                <div className="space-y-1">
+                  <Label htmlFor="demo-booking-status">Booking status</Label>
+                  <Select
+                    value={bookingStatus}
+                    onValueChange={(value) => setBookingStatus(value as DemoBookingStatus)}
+                  >
+                    <SelectTrigger id="demo-booking-status" data-testid="booking-status-select">
+                      <SelectValue />
+                    </SelectTrigger>
+                    <SelectContent>
+                      {ALL_DEMO_BOOKING_STATUSES.map((status) => (
+                        <SelectItem key={status} value={status}>
+                          {status.replace(/_/g, ' ')}
+                          {(ACTIVE_BOOKING_STATUSES as readonly string[]).includes(status)
+                            ? ' (active)'
+                            : ''}
+                        </SelectItem>
+                      ))}
+                    </SelectContent>
+                  </Select>
+                </div>
+                <div className="flex items-center justify-between gap-3">
+                  <Label htmlFor="demo-owns-booking" className="text-sm font-normal">
+                    Requesting provider owns this booking
+                  </Label>
+                  <Switch
+                    id="demo-owns-booking"
+                    data-testid="owns-booking-switch"
+                    checked={providerOwnsBooking}
+                    onCheckedChange={setProviderOwnsBooking}
+                  />
+                </div>
+              </CardContent>
+            </Card>
+
+            {projection ? (
+              <ProviderComfortCardShell projection={projection} />
+            ) : (
+              <div
+                className="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
+                data-testid="projection-dark-note"
+              >
+                <MoonStar className="h-4 w-4" aria-hidden />
+                <span>
+                  Nothing is shared right now
+                  {!providerOwnsBooking
+                    ? ' — this provider does not own the booking (server: 404).'
+                    : !isActiveStatus
+                      ? ' — the booking is not active (server: 404).'
+                      : consentStatus !== 'active'
+                        ? ' — the client has not granted (or has withdrawn) consent (server: 404).'
+                        : ' — the client has not made any category visible, or nothing is saved yet (server: 404).'}
+                </span>
+              </div>
+            )}
+          </section>
+        </div>
+      </div>
+    </div>
+  );
+}
