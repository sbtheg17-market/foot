+/**
+ * Phase 4C — Comfort demo harness — FIXTURE DATA ONLY.
+ *
+ * Frontend mirror of the canonical fixtures and the pure projection filter in
+ * artifacts/api-server/src/contracts/comfort-profile.contract.ts. The mirror
+ * exists only so the demo can visualize contract behavior without any API,
+ * storage, or codegen. At implementation step C-2/C-3 the server projection
+ * becomes the single authority and this file is deleted.
+ *
+ * Nothing here persists: state lives in React memory and resets on reload.
+ */
+
+export const VISIBILITY_CATEGORIES = [
+  'bookingReason',
+  'comfort',
+  'sensitivities',
+  'accessibility',
+  'setting',
+  'appointmentShape',
+  'communication',
+  'visitNote',
+] as const;
+export type CategoryKey = (typeof VISIBILITY_CATEGORIES)[number];
+export type VisibilityFlags = Record<CategoryKey, boolean>;
+
+export function defaultVisibility(): VisibilityFlags {
+  return {
+    bookingReason: false,
+    comfort: false,
+    sensitivities: false,
+    accessibility: false,
+    setting: false,
+    appointmentShape: false,
+    communication: false,
+    visitNote: false,
+  };
+}
+
+export interface DemoPreferences {
+  bookingReason?: string;
+  pressurePreference?: string;
+  touchSensitivity?: string;
+  temperaturePreference?: string;
+  fragrancePreference?: string;
+  sensitivityFlags?: string[];
+  accessibilityNeeds?: string[];
+  settingPreference?: string;
+  preferredDurationBucket?: string;
+  preferredTimeWindows?: string[];
+  communicationPreference?: string;
+  languagePreference?: string;
+  visitNote?: string;
+}
+
+/** Mirrors fullValidPreferences in the API fixtures. */
+export const SAMPLE_PREFERENCES: DemoPreferences = {
+  bookingReason: 'recurring_care',
+  pressurePreference: 'light',
+  touchSensitivity: 'high',
+  temperaturePreference: 'warmer',
+  fragrancePreference: 'fragrance_free_required',
+  sensitivityFlags: ['sensitive_skin', 'allergy_latex'],
+  accessibilityNeeds: ['limited_mobility', 'stairs_at_entrance'],
+  settingPreference: 'at_home_only',
+  preferredDurationBucket: 'standard_60',
+  preferredTimeWindows: ['weekday_morning', 'weekend_afternoon'],
+  communicationPreference: 'quiet_visit',
+  languagePreference: 'en',
+  visitNote: 'Please ring the bell twice; the front door sticks a little.',
+};
+
+/** Mirrors comfortAndAccessibilityVisible in the API fixtures. */
+export const SAMPLE_VISIBILITY: VisibilityFlags = {
+  ...defaultVisibility(),
+  comfort: true,
+  accessibility: true,
+};
+
+/** Exact active-status set (contract §2.6). */
+export const ACTIVE_BOOKING_STATUSES = ['confirmed', 'en_route', 'in_progress'] as const;
+export const ALL_DEMO_BOOKING_STATUSES = [
+  'requested',
+  'confirmed',
+  'en_route',
+  'in_progress',
+  'completed',
+  'cancelled',
+] as const;
+export type DemoBookingStatus = (typeof ALL_DEMO_BOOKING_STATUSES)[number];
+
+export interface DemoProjection {
+  bookingReason?: string;
+  comfort?: {
+    pressurePreference?: string;
+    touchSensitivity?: string;
+    temperaturePreference?: string;
+    fragrancePreference?: string;
+  };
+  sensitivities?: string[];
+  accessibility?: string[];
+  setting?: string;
+  appointmentShape?: {
+    preferredDurationBucket?: string;
+    preferredTimeWindows?: string[];
+  };
+  communication?: {
+    communicationPreference?: string;
+    languagePreference?: string;
+  };
+  visitNote?: string;
+}
+
+export interface DemoProjectionContext {
+  providerOwnsBooking: boolean;
+  bookingStatus: string;
+  consentActive: boolean;
+  preferences: DemoPreferences | null;
+  visibility: VisibilityFlags | null;
+}
+
+/**
+ * Pure mirror of buildProviderProjection (contract module). A null result is
+ * what the server surfaces as HTTP 404 — never 403 — so profile existence is
+ * never confirmed to an unauthorized caller.
+ */
+export function buildDemoProjection(ctx: DemoProjectionContext): DemoProjection | null {
+  if (!ctx.providerOwnsBooking) return null;
+  if (!(ACTIVE_BOOKING_STATUSES as readonly string[]).includes(ctx.bookingStatus)) return null;
+  if (!ctx.consentActive) return null;
+  if (ctx.preferences === null || ctx.visibility === null) return null;
+
+  const p = ctx.preferences;
+  const v = ctx.visibility;
+  const projection: DemoProjection = {};
+
+  if (v.bookingReason && p.bookingReason && p.bookingReason !== 'unspecified') {
+    projection.bookingReason = p.bookingReason;
+  }
+  if (v.comfort) {
+    const comfort: NonNullable<DemoProjection['comfort']> = {};
+    if (p.pressurePreference && p.pressurePreference !== 'unspecified') comfort.pressurePreference = p.pressurePreference;
+    if (p.touchSensitivity && p.touchSensitivity !== 'unspecified') comfort.touchSensitivity = p.touchSensitivity;
+    if (p.temperaturePreference && p.temperaturePreference !== 'unspecified') comfort.temperaturePreference = p.temperaturePreference;
+    if (p.fragrancePreference && p.fragrancePreference !== 'unspecified') comfort.fragrancePreference = p.fragrancePreference;
+    if (Object.keys(comfort).length > 0) projection.comfort = comfort;
+  }
+  if (v.sensitivities && p.sensitivityFlags && p.sensitivityFlags.length > 0) {
+    projection.sensitivities = [...p.sensitivityFlags];
+  }
+  if (v.accessibility && p.accessibilityNeeds && p.accessibilityNeeds.length > 0) {
+    projection.accessibility = [...p.accessibilityNeeds];
+  }
+  if (v.setting && p.settingPreference && p.settingPreference !== 'unspecified') {
+    projection.setting = p.settingPreference;
+  }
+  if (v.appointmentShape) {
+    const shape: NonNullable<DemoProjection['appointmentShape']> = {};
+    if (p.preferredDurationBucket && p.preferredDurationBucket !== 'unspecified') {
+      shape.preferredDurationBucket = p.preferredDurationBucket;
+    }
+    if (p.preferredTimeWindows && p.preferredTimeWindows.length > 0) {
+      shape.preferredTimeWindows = [...p.preferredTimeWindows];
+    }
+    if (Object.keys(shape).length > 0) projection.appointmentShape = shape;
+  }
+  if (v.communication) {
+    const comm: NonNullable<DemoProjection['communication']> = {};
+    if (p.communicationPreference && p.communicationPreference !== 'unspecified') {
+      comm.communicationPreference = p.communicationPreference;
+    }
+    if (p.languagePreference) comm.languagePreference = p.languagePreference;
+    if (Object.keys(comm).length > 0) projection.communication = comm;
+  }
+  if (v.visitNote && p.visitNote && p.visitNote.length > 0) {
+    projection.visitNote = p.visitNote;
+  }
+
+  if (Object.keys(projection).length === 0) return null;
+  return projection;
+}
