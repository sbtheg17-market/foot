+      testId="provider-leads"
+      title="Today's Leads"
+      subtitle="Your daily ground game — incoming interest, its source, and the next step."
+      data={data}
+      isLoading={isLoading}
+      isError={isError}
+      onRetry={() => refetch()}
+    />
+  );
+}
