+          <Icon className="h-4.5 w-4.5 text-slate-500" size={18} />
+        </span>
+        <span className="text-sm font-medium">{label}</span>
+      </div>
+      <div className="inline-flex rounded-lg border border-slate-200 bg-slate-50 p-1">
+        {options.map((opt) => {
+          const active = value === opt.value;
+          return (
+            <button
+              key={opt.value}
