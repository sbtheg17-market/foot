+            />
+            <OptionRow
+              icon={Lamp}
+              label="Lighting"
+              options={LIGHTING_OPTIONS}
+              value={draft.lighting}
+              onChange={(v) => setField("lighting", v)}
+              testIdPrefix="comfort-shell-lighting"
+            />
+            <OptionRow
+              icon={Volume2}
+              label="Noise level"
+              options={NOISE_OPTIONS}
