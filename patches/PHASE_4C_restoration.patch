+  { value: "quiet", label: "Quiet" },
+  { value: "low", label: "Low" },
+  { value: "moderate", label: "Moderate" },
+];
+
+const EMPTY_DRAFT = { temperature: null, lighting: null, noise: null, notes: "" };
+
+function OptionRow({ icon: Icon, label, options, value, onChange, testIdPrefix }) {
