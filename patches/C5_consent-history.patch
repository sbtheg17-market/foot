+# ---- 7. getConsentHistory — GET /api/comfort-profile/consent/history -> 200 | 401 ---
+#      V3.1 ADDENDUM operation (contract §11) — owner-scoped, read-only, append-only
+#      evidence. Exposes the patient's own consent timeline: every grant and
+#      withdrawal with timestamp, scope, consent text version, text hash and purpose.
+#      Rows recorded before versioning surface null version fields (legacy-tolerant).
+@router.get("/comfort-profile/consent/history")
+async def get_consent_history(request: Request):
+    patient_id = await _patient_id(request)
+    if not patient_id:
+        return _unauthorized()
+    rows = await consents.find({"patientId": patient_id}).sort("ts", -1).to_list(500)
+    history = [
+        {
+            "id": r.get("id"),
+            "status": r.get("status"),
+            "scope": r.get("scope") or [],
+            "consentVersion": r.get("consentVersion"),
+            "consentTextHash": r.get("consentTextHash"),
+            "purpose": r.get("purpose"),
+            "createdAt": r.get("createdAt"),
+        }
+        for r in rows
+    ]
+    return JSONResponse(
+        status_code=200,
+        content={
+            "history": history,
+            # Current consent statement — single source of truth for the grant UI.
+            "consentText": CONSENT_TEXT,
+            "consentTextVersion": CONSENT_TEXT_VERSION,
+            "consentTextHash": CONSENT_TEXT_HASH,
+        },
+    )
